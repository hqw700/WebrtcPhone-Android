<?xml version="1.0" encoding="utf-8"?>
<!--
  穿云投屏 Logo 前景（矢量，稍放大并处于自适应安全区内）：
  霓虹手机轮廓（青→紫渐变）+ 屏幕内云朵 + 投屏信号波。双层描边做辉光。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 辉光底层 -->
    <path
        android:strokeWidth="11"
        android:strokeAlpha="0.4"
        android:fillColor="#00000000"
        android:strokeLineJoin="round"
        android:pathData="M33,15 L75,15 A11,11 0 0 1 86,26 L86,82 A11,11 0 0 1 75,93 L33,93 A11,11 0 0 1 22,82 L22,26 A11,11 0 0 1 33,15 Z">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="22" android:startY="15" android:endX="86" android:endY="93">
                <item android:offset="0" android:color="#FF2BE6FF" />
                <item android:offset="1" android:color="#FFB24BFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 手机外框主线 -->
    <path
        android:strokeWidth="5"
        android:fillColor="#00000000"
        android:strokeLineJoin="round"
        android:pathData="M33,15 L75,15 A11,11 0 0 1 86,26 L86,82 A11,11 0 0 1 75,93 L33,93 A11,11 0 0 1 22,82 L22,26 A11,11 0 0 1 33,15 Z">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="22" android:startY="15" android:endX="86" android:endY="93">
                <item android:offset="0" android:color="#FF4DEBFF" />
                <item android:offset="1" android:color="#FFC06BFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 听筒 -->
    <path android:strokeColor="#FF54ECFF" android:strokeWidth="4.4" android:strokeLineCap="round"
        android:fillColor="#00000000" android:pathData="M46,22.5 L62,22.5" />
    <!-- Home 指示条 -->
    <path android:strokeColor="#FFBE6CFF" android:strokeWidth="4.4" android:strokeLineCap="round"
        android:fillColor="#00000000" android:pathData="M46,85.5 L62,85.5" />

    <!-- 屏幕内：云朵 -->
    <path
        android:strokeWidth="4.4"
        android:strokeColor="#FF8CD9FF"
        android:fillColor="#00000000"
        android:strokeLineJoin="round"
        android:pathData="M39,67
            A7,7 0 0 1 39.6,53.2
            A8.6,8.6 0 0 1 56,51
            A6,6 0 0 1 63,57
            A5.5,5.5 0 0 1 62.2,67 Z" />

    <!-- 屏幕内：投屏信号波 -->
    <path android:strokeColor="#FF8CD9FF" android:strokeWidth="4" android:strokeLineCap="round"
        android:fillColor="#00000000" android:pathData="M54.5,46 A7.6,7.6 0 0 1 62,53.5" />
    <path android:strokeColor="#FF8CD9FF" android:strokeWidth="4" android:strokeLineCap="round"
        android:fillColor="#00000000" android:pathData="M54.5,39 A14.5,14.5 0 0 1 69,53.5" />
    <path android:fillColor="#FF8CD9FF"
